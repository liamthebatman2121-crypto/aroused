# Create an API key and verify a sending domain at https://resend.com/
RESEND_API_KEY=re_replace_with_your_key
AROUSED_FROM_EMAIL="Aroused <verify@your-verified-domain.example>"

# Optional. If omitted, a random secret is stored in the local SQLite database.
AROUSED_EMAIL_CODE_SECRET=replace-with-a-long-random-secret

# Optional: bootstrap the first administrator on server start. Use a unique,
# private password with at least 14 characters. Never commit your real .env.
AROUSED_ADMIN_EMAIL=admin@example.com
AROUSED_ADMIN_PASSWORD=replace-with-a-unique-long-password

# Optional local paths/limits for development and isolated test runs.
# AROUSED_DATA_DIR=./data
# AROUSED_UPLOAD_DIR=./uploads
# AROUSED_API_PORT=8767
# AROUSED_MAX_UPLOAD_BYTES=104857600

# The S3-compatible private storage adapter is implemented, but no bucket has
# been configured or verified. Production also requires all public-access blocks
# and BucketOwnerEnforced ownership. Do not add real credentials to this file.
# AROUSED_STORAGE_DRIVER=s3
# AROUSED_OBJECT_STORAGE_BUCKET=private-bucket-name
# AROUSED_OBJECT_STORAGE_REGION=us-east-1
# AROUSED_OBJECT_STORAGE_ACCESS_KEY_ID=replace-in-secret-manager
# AROUSED_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-in-secret-manager
# Or, on a supported cloud platform, use its instance role:
# AROUSED_OBJECT_STORAGE_USE_INSTANCE_ROLE=true
# Optional S3-compatible endpoint and path-style addressing:
# AROUSED_OBJECT_STORAGE_ENDPOINT=https://objects.example.invalid
# AROUSED_OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Production deployment must explicitly configure these values in the platform
# environment/secret manager. Never copy real values into this example file.
# NODE_ENV=production
# AROUSED_BIND_HOST=0.0.0.0
# AROUSED_API_PORT=8767
# AROUSED_DATA_DIR=/persistent/aroused-data
# AROUSED_PUBLIC_BASE_URL=https://your-domain.example
# AROUSED_ALLOWED_ORIGINS=https://your-domain.example

# OAuth, age assurance, malware scanning, known-content matching, content
# safety, consent/rights evidence verification, and image/video processing
# providers are not operational. Setting credentials alone will not enable them.
# Social OAuth credentials are intentionally empty. Register the exact callback
# URL with each provider before configuring these in a private .env/secret store.
# Local callback URLs:
#   http://localhost:8767/api/auth/oauth/google/callback
#   http://localhost:8767/api/auth/oauth/reddit/callback
#   http://localhost:8767/api/auth/oauth/x/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8767/api/auth/oauth/google/callback
# REDDIT_OAUTH_CLIENT_ID=
# REDDIT_OAUTH_CLIENT_SECRET=
# REDDIT_OAUTH_REDIRECT_URI=http://localhost:8767/api/auth/oauth/reddit/callback
# X_OAUTH_CLIENT_ID=
# X_OAUTH_CLIENT_SECRET=
# X_OAUTH_REDIRECT_URI=http://localhost:8767/api/auth/oauth/x/callback
